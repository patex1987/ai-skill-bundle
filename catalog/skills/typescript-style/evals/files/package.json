{
  "name": "example-tools",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "ci": "npm run format:check && npm run lint && npm run build && npm test"
  }
}
